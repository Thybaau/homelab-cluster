# Trivy ignore file for homelab-cluster
# False positives and accepted risks

# KSV-0125: "untrusted registry" — flags all non-docker.io/library images
# Our images from ghcr.io, cloudflare/, etc. are legitimate
KSV-0125

# KSV-0037: "should not be set with kube-system namespace"
# Traefik is installed by k3s in kube-system by default, PodMonitor/SealedSecret must match
KSV-0037

# KSV-01010: "ConfigMap stores sensitive contents"
# Homepage dashboard widget config uses keys like "key", "username" as field names, not real secrets
KSV-01010

# KSV-0117: "port < 1024"
# Standard for nginx/frontend containers serving on port 80 behind a reverse proxy
KSV-0117

# KSV-0109: "ConfigMap stores secrets"
# Homepage config uses HOMEPAGE_VAR_* env variable references to SealedSecrets, not actual passwords
KSV-0109

# KSV-0012: "runAsNonRoot should be true"
# valhafin-frontend uses nginx standard which requires root for port 80 bind
# Migration to nginx-unprivileged (port 8080) planned as separate ticket
KSV-0012

# KSV-0022: "capabilities.add should not be set"
# valhafin-frontend needs NET_BIND_SERVICE for nginx port 80
# Will be removed when migrating to nginx-unprivileged
KSV-0022

# KSV-0111: "User with admin access" (ClusterRoleBinding to cluster-admin)
# System Upgrade Controller requires cluster-admin to create Jobs, cordon/drain nodes,
# modify annotations, and manage the full upgrade lifecycle. This is the official design
# from Rancher: https://github.com/rancher/system-upgrade-controller
KSV-0111

# KSV-0023: "HostPath Volumes" forbidden by pod security standard
# System Upgrade Controller needs read-only access to host CA certificates
# (/etc/ssl, /etc/pki, /etc/ca-certificates) to validate TLS connections
# to the K3s update channel (https://update.k3s.io). This is the official
# deployment pattern from Rancher.
KSV-0023

# KSV-0121: "hostPath volume mounted at root" — sensitive host path
# disk-usage-exporter DaemonSet needs read-only access to the full host filesystem
# to calculate per-directory disk usage. The volume is mounted readOnly with
# the container running as non-root (UID 65534) with only DAC_READ_SEARCH capability.
KSV-0121

# KSV-0106: "container capabilities must only include NET_BIND_SERVICE"
# disk-usage-exporter needs DAC_READ_SEARCH to read host directories regardless
# of file permissions (many k3s/containerd dirs are 0700 root-owned).
# This is the minimal capability required — no privilege escalation, no full root.
KSV-0106
