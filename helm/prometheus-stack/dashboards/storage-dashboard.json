{
  "uid": "storage",
  "title": "Stockage",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(node_uname_info, nodename)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "label": "Nœud"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Utilisation disque des VMs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Disque utilisé par nœud (%)",
      "description": "Pourcentage d'utilisation du disque principal par nœud — Vert < 70%, Orange 70-85%, Rouge > 85%",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"}) * 100 * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "Aucune métrique disque disponible",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Espace utilisé par nœud (Go)",
      "description": "Espace disque utilisé sur le disque principal de chaque nœud, en gigaoctets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"} - node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"}) / 1024 / 1024 / 1024 * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "noValue": "Aucune métrique disque disponible",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 40 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Espace total par nœud (Go)",
      "description": "Capacité totale du disque principal de chaque nœud, en gigaoctets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"} / 1024 / 1024 / 1024 * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "noValue": "Aucune métrique disque disponible",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "PVCs — Volumes persistants",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "table",
      "title": "Inventaire des PVCs",
      "description": "Liste des Persistent Volume Claims avec leur capacité demandée et le nœud hébergeant le volume. Note : le local-path provisioner ne permet pas de mesurer l'utilisation réelle par PVC.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "kube_persistentvolumeclaim_resource_requests_storage_bytes",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "kubelet_volume_stats_used_bytes{job=\"kubelet\"} * 0 + 1",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "Aucun PVC détecté"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "unit", "value": "decbytes" },
              { "id": "displayName", "value": "Capacité demandée" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          { "displayName": "Capacité demandée", "desc": true }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "persistentvolumeclaim",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "container": true,
              "endpoint": true,
              "endpoint 1": true,
              "endpoint 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "metrics_path": true,
              "metrics_path 1": true,
              "metrics_path 2": true,
              "pod": true,
              "service": true,
              "service 1": true,
              "service 2": true,
              "exported_namespace": true,
              "namespace 2": true,
              "Value #B": true
            },
            "indexByName": {
              "persistentvolumeclaim": 0,
              "namespace": 1,
              "node": 2,
              "Value #A": 3
            },
            "renameByName": {
              "namespace": "Namespace",
              "persistentvolumeclaim": "PVC",
              "node": "Nœud",
              "Value #A": "Capacité demandée"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Top consommateurs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Top consommateurs d'espace disque",
      "description": "Les 10 plus gros mountpoints par espace utilisé, tous nœuds confondus (hors tmpfs et overlay)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 19 },
      "targets": [
        {
          "expr": "topk(10, (node_filesystem_size_bytes{fstype!=\"tmpfs\", fstype!=\"overlay\"} - node_filesystem_avail_bytes{fstype!=\"tmpfs\", fstype!=\"overlay\"}) * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"}) / 1024 / 1024 / 1024",
          "legendFormat": "{{nodename}} — {{mountpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "noValue": "Aucune métrique filesystem disponible",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 40 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Utilisation par dossier (disk_usage_exporter)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Top dossiers par taille (Go)",
      "description": "Les 20 plus gros dossiers détectés par disk_usage_exporter sur tous les nœuds — permet d'identifier précisément ce qui consomme l'espace disque",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 29 },
      "targets": [
        {
          "expr": "topk(20, node_disk_usage_bytes * on(pod) group_left(node) kube_pod_info{namespace=\"monitoring\", created_by_kind=\"DaemonSet\"}) / 1024 / 1024 / 1024",
          "legendFormat": "{{node}} — {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "noValue": "Aucune métrique disk_usage_exporter disponible — vérifier que l'exporter est déployé",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 15
      }
    }
  ]
}
