{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  customManagers: [
    {
      customType: 'regex',
      fileMatch: ['ansible/group_vars/all\\.yml$'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\n[\\w_]+:\\s*(?<currentValue>v[^\\s]+)',
      ],
      versioning: 'semver',
    },
  ],
  argocd: {
    managerFilePatterns: [
      '/argocd-apps/.+\\.ya?ml$/',
    ],
  },
  schedule: [
    'after 8pm every weekday',
    'every weekend',
    'before 8am every weekday',
  ],
  prHourlyLimit: 5,
  prConcurrentLimit: 10,
  labels: [
    'renovate',
  ],
  dependencyDashboard: true,
  packageRules: [
    {
      description: 'Automerge patch updates pour les images Docker (apps)',
      matchManagers: [
        'helm-values',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Automerge minor/patch updates pour les GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Automerge patch updates pour les charts Helm upstream (ArgoCD multi-source)',
      matchManagers: [
        'argocd',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Automerge minor updates le week-end (images Docker)',
      matchManagers: [
        'helm-values',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      automerge: true,
      automergeType: 'pr',
      schedule: [
        'every weekend',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      description: 'Automerge minor updates le week-end (charts upstream ArgoCD)',
      matchManagers: [
        'argocd',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      automerge: true,
      automergeType: 'pr',
      schedule: [
        'every weekend',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      description: 'Major updates - review manuelle requise',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'renovate',
        'major-update',
        'review-needed',
      ],
    },
    {
      description: 'Infrastructure critique (ArgoCD, cert-manager via helmfile) - review manuelle',
      matchManagers: [
        'helmfile',
      ],
      automerge: false,
      labels: [
        'renovate',
        'infrastructure',
        'review-needed',
      ],
    },
    {
      description: 'Composants sensibles - jamais d automerge, delai 14 jours',
      matchFileNames: [
        'helm/sealed-secrets/**',
        'helm/metallb/**',
        'helm/traefik-tls/**',
      ],
      automerge: false,
      labels: [
        'renovate',
        'critical-infra',
        'review-needed',
      ],
      minimumReleaseAge: '14 days',
    },
    {
      description: 'Groupe les updates monitoring ensemble',
      matchFileNames: [
        'helm/prometheus-stack/**',
        'helm/loki/**',
        'helm/alloy/**',
        'helm/blackbox-exporter/**',
        'helm/postgres-exporter/**',
      ],
      groupName: 'monitoring-stack',
    },
    {
      description: 'Groupe les charts monitoring upstream (ArgoCD apps)',
      matchFileNames: [
        'argocd-apps/prometheus-stack-app.yml',
        'argocd-apps/loki-app.yml',
        'argocd-apps/alloy-app.yml',
        'argocd-apps/blackbox-exporter-app.yml',
        'argocd-apps/postgres-exporter-app.yml',
      ],
      groupName: 'monitoring-stack-charts',
    },
    {
      description: 'Valhafin images privees - pas d automerge',
      matchFileNames: [
        'helm/valhafin/**',
      ],
      automerge: false,
      matchPackageNames: [
        '/ghcr.io/thybaau/valhafin/.*/',
      ],
    },
    {
      description: 'CLI tools (kubectl, helm, helmfile) - automerge patch',
      matchFileNames: ['ansible/group_vars/all.yml'],
      matchManagers: ['custom.regex'],
      matchUpdateTypes: ['patch'],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
      groupName: 'cli-tools',
    },
    {
      description: 'CLI tools - automerge minor le week-end',
      matchFileNames: ['ansible/group_vars/all.yml'],
      matchManagers: ['custom.regex'],
      matchUpdateTypes: ['minor'],
      automerge: true,
      automergeType: 'pr',
      schedule: ['every weekend'],
      minimumReleaseAge: '7 days',
      groupName: 'cli-tools',
    },
    {
      description: 'PostgreSQL - bloquer les major updates (migration requise)',
      matchPackageNames: [
        'postgres',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      description: 'Python dependencies (Ansible tooling) - pas d automerge sur major',
      matchManagers: [
        'pip_requirements',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'renovate',
        'tooling',
        'review-needed',
      ],
    },
    {
      description: 'Python dependencies - automerge minor/patch',
      matchManagers: [
        'pip_requirements',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
    },
  ],
}
